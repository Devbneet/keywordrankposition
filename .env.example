# Digital Minds Keyword Ranking Automation - Environment Variables
# Copy this file to .env and fill in your local values. Never commit .env to GitHub.

# Browser settings
BROWSER_HEADLESS=true
BROWSER_SLOW_MO_MS=0

# Default locale settings (used in later phases)
DEFAULT_LANGUAGE=en-US

# Google Sheets API credentials path (used in Phase 6+)
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account.json

# Storage & logging
SQLITE_DB_PATH=data/rankings.db
LOG_LEVEL=INFO

