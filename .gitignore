# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Environment variables & secrets
.env
.env.*
!.env.example

# Client configurations & credentials (never commit private client data)
config/clients.json
config/*.local.json
credentials/
*.pem
*.key
service_account*.json
client_secret*.json

# Runtime data, backups, logs, screenshots, local DBs
data/*
!data/.gitkeep
backups/*
!backups/.gitkeep
logs/*
!logs/.gitkeep
screenshots/*
!screenshots/.gitkeep
*.db
*.sqlite
*.sqlite3

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
