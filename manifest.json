{
  "manifest_version": 3,
  "name": "Digital Minds Rank Tracker",
  "version": "1.0.0",
  "version_name": "1.0.0-rc.1",
  "description": "Internal agency Chrome extension for location-accurate organic keyword ranking checks and design-preserving Google Sheets updates.",
  "permissions": [
    "storage",
    "tabs",
    "debugger",
    "identity",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://sheets.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "235161166679-h3shfo37upsidj941vnkqtebqs533pgp.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets.readonly"
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Digital Minds Rank Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}